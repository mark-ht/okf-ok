{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "okflint",
          "informationUri": "https://github.com/mark-ht/okf-ok",
          "rules": [
            {
              "id": "OKF010",
              "shortDescription": {
                "text": "Malformed, missing, or unreadable concept frontmatter"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "OKF011",
              "shortDescription": {
                "text": "Concept frontmatter is not a YAML mapping"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "OKF012",
              "shortDescription": {
                "text": "Concept frontmatter lacks a non-empty type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "OKF100",
              "shortDescription": {
                "text": "Reference escapes the bundle or traverses a symlink"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "OKF101",
              "shortDescription": {
                "text": "Local reference target does not exist"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "OKF102",
              "shortDescription": {
                "text": "Reference target is invalid or unsupported"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "OKF103",
              "shortDescription": {
                "text": "Source resource could be a non-followable scope descriptor"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "OKF104",
              "shortDescription": {
                "text": "Local Markdown fragment is unsupported or missing"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "OKF200",
              "shortDescription": {
                "text": "Remote URL could not be confirmed"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "OKF201",
              "shortDescription": {
                "text": "Remote URL is permanently unavailable"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "OKF202",
              "shortDescription": {
                "text": "Remote URL redirects"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "OKF203",
              "shortDescription": {
                "text": "Remote URL was skipped by policy or budget"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "OKF101",
          "level": "warning",
          "message": {
            "text": "local target does not exist"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "metrics/revenue.md"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 15
                }
              }
            }
          ],
          "properties": {
            "field": "sources[0].resource",
            "reference_kind": "frontmatter.sources.resource",
            "resolved": "metrics/policies/revenue.md",
            "target": "policies/revenue.md"
          }
        },
        {
          "ruleId": "OKF201",
          "level": "warning",
          "message": {
            "text": "remote URL returned a permanent not-found response (HTTP 410)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "references/docs.md"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 3
                }
              }
            }
          ],
          "properties": {
            "outcome": "gone",
            "reference_kind": "markdown.link",
            "target": "https://example.com/gone"
          }
        }
      ]
    }
  ]
}
